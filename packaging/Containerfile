FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl file g++ pkg-config dpkg-dev fakeroot patchelf \
    qt6-base-dev qt6-base-dev-tools qt6-wayland python3 python3-pip python3-venv \
    libusb-1.0-0 pulseaudio-utils pipewire-bin libfuse2 libgl1 libegl1 \
    libxkbcommon0 libxcb-cursor0 desktop-file-utils \
    && python3 -m pip install --no-cache-dir pyinstaller==6.22.3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends libgl-dev libpython3.10 && rm -rf /var/lib/apt/lists/*
