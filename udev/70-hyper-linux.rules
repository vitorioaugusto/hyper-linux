# Grant the active local user access to supported dongles (no world-writable mode).
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="03f0", ATTRS{idProduct}=="05b7", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="03f0", ATTRS{idProduct}=="0c9d", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="03f0", ATTR{idProduct}=="05b7", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="03f0", ATTR{idProduct}=="0c9d", TAG+="uaccess"
